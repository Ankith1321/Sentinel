# Copy to .env and fill in real values. .env is gitignored, never commit it.

# --- LLM ---------------------------------------------------------------
# With a key, Sentinel answers with Claude. Without one it falls back to the local Qwen model.
ANTHROPIC_API_KEY=
# auto | anthropic | local
SENTINEL_LLM_PROVIDER=auto
SENTINEL_ANTHROPIC_MODEL=claude-haiku-5-5

# --- API auth ----------------------------------------------------------
# Accepted on every route and the only key allowed on /admin/*. Generate a long random value.
SENTINEL_API_KEY=
# Set to "off" only for local development.
SENTINEL_AUTH=on
SENTINEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Retrieval ---------------------------------------------------------
# vector | keyword | hybrid | hybrid_rerank
SENTINEL_RETRIEVAL_MODE=vector
SENTINEL_COLLECTION=superset_codebase

# --- Frontend (put these in frontend/.env.local, server side only) -----
# SENTINEL_API_URL=http://127.0.0.1:8000
# SENTINEL_API_KEY=<same value as above>
# Leave NEXT_PUBLIC_API_URL unset: the browser talks to the built-in /api proxy, which adds the key.
