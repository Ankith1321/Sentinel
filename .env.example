# Copy to .env and fill in real values. .env is gitignored, never commit it.

# --- LLM ---------------------------------------------------------------
# auto picks, in order: Claude (ANTHROPIC_API_KEY set), an OpenAI-compatible endpoint (below),
# the local Qwen model (NVIDIA GPU present), otherwise "none": no model, so answers list the closest
# passages with citations instead of written text.
ANTHROPIC_API_KEY=
# auto | anthropic | openai | local | none
SENTINEL_LLM_PROVIDER=auto
# Optional, e.g. a free-tier key from OpenRouter, Groq or Gemini's compatibility endpoint.
# Tested against a mock server only, never against a real service.
# SENTINEL_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# SENTINEL_OPENAI_MODEL=
# SENTINEL_OPENAI_API_KEY=
SENTINEL_ANTHROPIC_MODEL=claude-haiku-5-5
# Local fallback, fp16 on an NVIDIA GPU. Qwen2.5-3B is licensed for non-commercial use only.
SENTINEL_LOCAL_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
# v2 = strict citation prompt (measured best); v1 = original prompt
SENTINEL_PROMPT_VARIANT=v2

# --- API auth ----------------------------------------------------------
# Required in the X-API-Key header on every route except /health. Generate a long random value.
SENTINEL_API_KEY=
# Set to "off" only for local development.
SENTINEL_AUTH=on
SENTINEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Retrieval ---------------------------------------------------------
# vector | keyword | hybrid
SENTINEL_RETRIEVAL_MODE=hybrid
SENTINEL_COLLECTION=superset_codebase
# Where the vector index lives. Point this at a mounted volume in a container.
# SENTINEL_CHROMA_PATH=data/indexes/chroma

# --- Frontend (put these in frontend/.env.local, server side only) -----
# SENTINEL_API_URL=http://127.0.0.1:8000
# SENTINEL_API_KEY=<same value as above>
# Leave NEXT_PUBLIC_API_URL unset: the browser talks to the built-in /api proxy, which adds the key.
